import os
import json
from dotenv import load_dotenv
from openai import OpenAI

# 1. Load API key
load_dotenv(".env")
api_key = os.environ.get("DEEPSEEK_API_KEY")

# 2. Initialize client (DeepSeek uses OpenAI-compatible format)
client = OpenAI(
    api_key=api_key,
    base_url="https://api.deepseek.com"
)

# 3. System prompt for MCQ generation
SYSTEM_PROMPT = """You are an expert exam question generator for a Zoology textbook.
Your task is to create high-quality multiple-choice questions (MCQs) based ONLY on the provided text.

Rules:
1. Generate exactly 5 MCQs per chunk.
2. Each question must have exactly 4 options (A, B, C, D).
3. Exactly one option must be correct.
4. Cover definitions, functions, processes, and comparisons.
5. Avoid trivial questions.
6. Return ONLY valid JSON, no markdown, no explanation.

Output format:
[
  {
    "question": "Question text here?",
    "options": {"A": "...", "B": "...", "C": "...", "D": "..."},
    "answer": "B",
    "explanation": "Brief explanation from the text."
  }
]
"""

def generate_mcqs(chunk_text):
    """Send chunk to DeepSeek, return list of MCQs."""
    response = client.chat.completions.create(
        model="deepseek-flash",
        messages=[
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": f"Generate 5 MCQs from this text:\n\n{chunk_text}"}
        ],
        response_format={"type": "json_object"},
        max_tokens=2000,
        temperature=0.7
    )
    return json.loads(response.choices[0].message.content)

# 4. Load your chunks
with open("chapter1_chunks.json", "r", encoding="utf-8") as f:
    chunks = json.load(f)

print(f"Total chunks: {len(chunks)}")

# 5. Test on first 2 chunks
all_mcqs = []
for i, chunk in enumerate(chunks[:2]):
    text = chunk["text"]
    if len(text) < 500:
        print(f"Chunk {i} too short, skipping.")
        continue
    
    print(f"\nProcessing chunk {i} ({len(text)} chars)...")
    try:
        mcqs = generate_mcqs(text)
        all_mcqs.append({"chunk_id": chunk["id"], "mcqs": mcqs})
        print(f"  Generated {len(mcqs)} MCQs")
    except Exception as e:
        print(f"  Error: {e}")

# 6. Preview output
if all_mcqs:
    print("\n--- Sample Output ---")
    print(json.dumps(all_mcqs[0], indent=2)[:1500])


