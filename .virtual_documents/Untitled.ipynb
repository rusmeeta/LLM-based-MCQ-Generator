import pymupdf

# Open PDF
doc = pymupdf.open("Zoology.pdf")

print("Total pages:", len(doc))

text = ""

for page_number in range(21,57):
    text += doc[page_number].get_text()+"\n"

doc.close()

print("Characters extracted:", len(text))
print(text[:3000])


lines = []

for line in text.splitlines():
    line = line.strip()

    if line:
        lines.append(line)

cleaned_text = "\n".join(lines)

print(cleaned_text[:3000])


lines=cleaned_text.splitlines()
chapter1_lines=[]
start=False
for line in lines:
    if line=="UNIT I A":
        start=True
    if start:
        chapter1_lines.append(line)
chapter1_text="\n".join(chapter1_lines)
print(chapter1_text[:3000])


lines=chapter1_text.splitlines()
cleaned_lines=[]
for line in lines:
    line=line.strip()

    if line=="Human Anatomy and":
        continue

    if line=="Physiology - I":
        continue

    if line == "Zoology":
        continue

    if line:
        cleaned_lines.append(line)
        
final_text= "\n".join(cleaned_lines)

print(final_text[:3000])


lines = chapter1_text.splitlines()

fixed_lines = []

for i in range(len(lines)):
    line = lines[i].strip()

    if line.endswith("-")and i + 1 < len(lines):
        line = line + lines[i + 1].strip()

    fixed_lines.append(line)

final_text = "\n".join(fixed_lines)

print(final_text[:3000])


print("Total characters:", len(final_text))


chunk_size=8000
chunks=[]

for i in range(0, len(final_text), chunk_size):
    chunk= final_text[i: i+chunk_size]
    chunks.append(chunk)

print("Total chunks",len(chunks))


chunks[0]



